        <messages/>
        <name>Leave Handling and Validation</name>
        <order/>
        <script><![CDATA[function onSubmit(){

   //Type appropriate comment here, and begin script below
	var employee = g_form.getValue('employee');
	var startStr = g_form.getValue('start_date');
    var endStr = g_form.getValue('end_date');
    var leaveType = g_form.getValue('leave_type');

	var startDate = getDateFromFormat(startStr, g_user_date_format);
    var endDate = getDateFromFormat(endStr, g_user_date_format);

    var diffInMs = endDate - startDate;
    var days = diffInMs / (1000 * 60 * 60 * 24);
	
	g_form.setValue("number_of_leave_days", days);
	
	var ga = new GlideAjax("leaverequestutils");
	ga.addParam("sysparm_name", "leaveBalance");
	ga.addParam("employee", employee);
	ga.addParam("leave_type", leaveType);
	ga.addParam("current_days", days);
	ga.getXMLAnswer(balanceLeave);

}

function balanceLeave(balanceDays) {
	// balanceDays = parseInt(response);
	alert(balanceDays);
	g_form.setValue("leave_balance", balanceDays);

}]]></script>
